# ── Core ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
SECRET_KEY=change-me-to-a-random-50-char-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (Docker default shown; swap for your provider's URL) ─────
DATABASE_URL=postgres://saas_user:saas_pass@db:5432/saas_db

# ── Redis / Celery ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Email (use console backend for local dev, see settings/development.py)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourapp.com

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_MONTHLY=price_xxx
STRIPE_PRICE_ID_YEARLY=price_xxx

# ── Site ────────────────────────────────────────────────────────────
SITE_URL=http://localhost:8000
SITE_NAME=My SaaS

# ── Production only (S3-compatible storage, optional) ─────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

SENTRY_DSN=
